rules_version = '2';

// CoFi Firestore Security Rules
// =============================
// Replaces the previous open rules (`allow read, write: if true`).
//
// Design notes:
// - Admin identity is server-enforced: `isAdmin` lives on the user's own doc
//   but users can never write that field themselves (see /users match).
//   Promote/demote admins via Firebase Console (Console bypasses rules).
// - Shop ownership: `ownerId` (claimed/business) or `posterId` (community
//   submission). Only admins may transfer ownership between accounts.
// - Reviewers legitimately update aggregate rating fields on shop docs
//   (review_shop_screen.dart) — allowed ONLY when no other keys change.
// - Notification fan-out is currently client-side (acting user writes into
//   the recipient's notifications subcollection). Create is therefore open
//   to signed-in users; read/update/delete restricted to the recipient.
//   This tightens automatically when fan-out moves to Cloud Functions.
// - allJobs/pendingJobs are written ONLY by Cloud Functions (the Admin SDK
//   bypasses rules). Clients read them but can never write them; the old
//   client-side sync in lib/services/job_sync_service.dart has been removed
//   in favor of the shops/{shopId}/jobs triggers in functions/index.js.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isShopStaff(shopId) {
      return signedIn()
        && exists(/databases/$(database)/documents/shops/$(shopId))
        && (
          // Claimed shops: only the owner manages them. posterId no longer
          // grants rights once an owner exists, so original community
          // submitters lose edit access after a claim is approved.
          get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == request.auth.uid
          || (get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId == null
              && get(/databases/$(database)/documents/shops/$(shopId)).data.posterId == request.auth.uid)
        );
    }

    // True when an update touches nothing but the listed keys.
    function onlyTouches(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------- Users ----------
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isSelf(userId)
        && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false);

      // Owners edit their own profile but can never touch isAdmin.
      allow update: if isAdmin()
        || (isSelf(userId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin']));

      // Account self-deletion clears/anonymizes related data first.
      allow delete: if isAdmin() || isSelf(userId);

      // Notifications are written by other users' actions (fan-out),
      // but only the recipient can ever read or manage them. Create is
      // shape-validated AND type/role-allowlisted so a malicious client can't
      // invent arbitrary routing types; true sender verification still
      // requires moving fan-out to Cloud Functions.
      match /notifications/{notificationId} {
        allow read, update, delete: if isSelf(userId);
        allow create: if signedIn()
          && request.resource.data.get('title', '') is string
          && request.resource.data.title.size() <= 500
          && request.resource.data.get('body', '') is string
          && request.resource.data.body.size() <= 1000
          && request.resource.data.get('type', '') in
             ['event', 'event_participation', 'job', 'job_application',
              'shop', 'recommendation', 'review', 'review_reply', 'business_application',
              'chat']
          && request.resource.data.get('recipientRole', 'user') in ['user', 'business'];
      }

      // Per-user café lists (mirrors the top-level /lists rules below).
      // Ownership comes from the document PATH ({userId}), so `userId` in
      // the payload is optional — create_list_bottom_sheet.dart does not
      // write it, and requiring it made every collection save fail with
      // permission-denied.
      match /lists/{listId} {
        allow read: if signedIn();
        allow create: if isSelf(userId)
          && (!('userId' in request.resource.data)
              || request.resource.data.userId == request.auth.uid);
        allow update, delete: if isAdmin() || isSelf(userId);

        match /items/{itemId} {
          allow read: if signedIn();
          allow create: if isAdmin() || isSelf(userId);
          allow update, delete: if isAdmin() || isSelf(userId);
        }

        match /participants/{participantId} {
          allow read: if signedIn();
          allow create: if isAdmin() || isSelf(userId);
          allow update, delete: if isAdmin() || isSelf(userId);
        }
      }
    }

    // ---------- Collection-group reads ----------
    // Events and jobs are queried with collectionGroup() (community_repository.dart),
    // which cannot be proven scoped to /shops by the rules engine — these
    // wildcard matches make those feeds readable for signed-in users.
    match /{path=**}/events/{eventId} {
      allow read: if signedIn();
    }
    match /{path=**}/jobs/{jobId} {
      allow read: if signedIn();
    }
    match /{path=**}/promotions/{promotionId} {
      allow read: if signedIn();
    }
    // Visits, reviews and comments are also read via collectionGroup()
    // (activity stats, visited-cafes list, your-reviews screen), which
    // cannot be proven scoped to /shops by the rules engine.
    match /{path=**}/visits/{visitId} {
      allow read: if signedIn();
    }
    match /{path=**}/reviews/{reviewId} {
      allow read: if signedIn();
    }
    match /{path=**}/comments/{commentId} {
      allow read: if signedIn();
    }

    // ---------- Shops ----------
    match /shops/{shopId} {
      allow read: if signedIn();

      // Community/business submissions must start unverified & pending.
      // Without these checks any user could self-approve (`isVerified`,
      // `approvalStatus`) or assign someone else as `ownerId`.
      allow create: if signedIn()
        && request.resource.data.isVerified == false
        && request.resource.data.approvalStatus in ['pending_approval', 'awaiting_verification']
        && (!('ownerId' in request.resource.data)
            || request.resource.data.ownerId == null
            || request.resource.data.ownerId == request.auth.uid)
        && (!('posterId' in request.resource.data) || request.resource.data.posterId == request.auth.uid);
      allow delete: if isAdmin() || isShopStaff(shopId);

      // Staff/admin full edit — EXCEPT staff may never mark their own shop
      // verified or flip its status to approved (admin-only decisions).
      // Rating aggregates are maintained by the trusted review Cloud Function.
      allow update: if isAdmin()
        || (isShopStaff(shopId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerified'])
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviews', 'ratings'])
            && !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['approvalStatus'])
                 && request.resource.data.approvalStatus == 'approved'))
        ;

      // ----- Jobs (posted and managed by shop staff) -----
      match /jobs/{jobId} {
        allow read: if signedIn();
        // Only staff/admin may post jobs under a shop — a signed-in-only
        // create allowed impersonation of other businesses.
        allow create: if isAdmin() || isShopStaff(shopId);
        // Staff/admin manage jobs (incl. whole-applications-array rewrites
        // for accept/reject). Non-staff users may append EXACTLY ONE
        // application entry identifying themselves as the applicant.
        // NOTE: Firestore rules cannot diff list elements, so a malicious
        // client could still mutate earlier entries while appending its own
        // — full mitigation requires moving applications to a subcollection
        // (Phase 3 schema migration).
        allow update: if isAdmin() || isShopStaff(shopId)
          || (signedIn()
              && onlyTouches(['applications'])
              && request.resource.data.applications.size() == resource.data.get('applications', []).size() + 1
              && request.resource.data.applications == resource.data.get('applications', []).concat([
                   request.resource.data.applications[request.resource.data.applications.size() - 1]
                 ])
              && request.resource.data.applications[request.resource.data.applications.size() - 1].get('applicantId', '') == request.auth.uid);
        allow delete: if isAdmin() || isShopStaff(shopId);
      }

      // ----- Events -----
      match /events/{eventId} {
        allow read: if signedIn();
        allow create: if isAdmin() || isShopStaff(shopId);
        // Staff manage events; attendees may update participation counters
        // (RSVP increments run inside transactions on these fields).
        allow update: if isAdmin()
          || isShopStaff(shopId)
          || (signedIn()
              && onlyTouches(['participantsCount'])
              && resource.data.get('participantsCount', 0) is int
              && request.resource.data.participantsCount is int
              && request.resource.data.participantsCount >= 0
              && (
                (request.resource.data.participantsCount == resource.data.get('participantsCount', 0) + 1
                  && !exists(/databases/$(database)/documents/shops/$(shopId)/events/$(eventId)/participants/$(request.auth.uid))
                  && existsAfter(/databases/$(database)/documents/shops/$(shopId)/events/$(eventId)/participants/$(request.auth.uid)))
                ||
                (request.resource.data.participantsCount == resource.data.get('participantsCount', 0) - 1
                  && exists(/databases/$(database)/documents/shops/$(shopId)/events/$(eventId)/participants/$(request.auth.uid))
                  && !existsAfter(/databases/$(database)/documents/shops/$(shopId)/events/$(eventId)/participants/$(request.auth.uid)))
              ));
        allow delete: if isAdmin() || isShopStaff(shopId);

        // Comments: anyone signed-in may join the discussion;
        // authors and admins may edit/remove their own words.
        match /comments/{commentId} {
          allow read: if signedIn();
          allow create: if signedIn()
            && request.resource.data.userId == request.auth.uid;
          allow update, delete: if isAdmin()
            || (signedIn() && resource.data.userId == request.auth.uid);
        }

        match /participants/{participantId} {
          allow read: if signedIn();
          allow create: if signedIn()
            && participantId == request.auth.uid
            && request.resource.data.userId == request.auth.uid;
          allow update, delete: if isAdmin()
            || isShopStaff(shopId)
            || (signedIn()
                && participantId == request.auth.uid
                && resource.data.userId == request.auth.uid);
        }
      }

      // ----- Special offers -----
      // Offers are authored and managed only by the verified shop's staff.
      // Customer clients have read-only access and never perform redemption
      // writes in this first, low-cost version.
      match /promotions/{promotionId} {
        allow read: if signedIn();
        allow create, update: if isAdmin()
          || (isShopStaff(shopId)
              && get(/databases/$(database)/documents/shops/$(shopId)).data.isVerified == true
              && request.resource.data.shopId == shopId);
        allow delete: if isAdmin()
          || (isShopStaff(shopId)
              && get(/databases/$(database)/documents/shops/$(shopId)).data.isVerified == true);
      }

      // ----- Visit logs (independent of reviews by design) -----
      match /visits/{visitId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin()
          || (signedIn() && resource.data.userId == request.auth.uid);
      }

      // ----- Reviews -----
      match /reviews/{reviewId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;
        // Authors edit their own reviews; shop staff append responses.
        allow update: if isAdmin()
          || (signedIn()
              && resource.data.userId == request.auth.uid
              && request.resource.data.userId == request.auth.uid
              && request.resource.data.get('responses', []) == resource.data.get('responses', []))
          || (isShopStaff(shopId) && onlyTouches(['responses']));
        allow delete: if isAdmin()
          || (signedIn() && resource.data.userId == request.auth.uid);
      }

      match /menuImages/{imageId} {
        allow read: if signedIn();
        allow create, delete: if isAdmin() || isShopStaff(shopId);
      }
    }

    // ---------- Ownership claims ----------
    match /shop_claims/{claimId} {
      allow read: if signedIn() || isAdmin();
      // Claim docs use deterministic ids ({shopId}_{uid}) so concurrent
      // submissions are idempotent; claimants may (re)submit ONLY their own
      // still-pending claims.
      allow create: if signedIn()
        && request.resource.data.get('claimantId', '') == request.auth.uid
        && request.resource.data.get('status', 'pending') == 'pending';
      // Only admins decide claims. Claimants may submit/refresh their own
      // still-pending OR previously-rejected claim back to pending (docs use
      // deterministic {shopId}_{uid} ids, so re-submission is an UPDATE);
      // they can never touch an approved claim or change its shopId.
      allow update: if isAdmin()
        || (signedIn()
            && resource.data.get('claimantId', '') == request.auth.uid
            && request.resource.data.get('claimantId', '') == request.auth.uid
            && resource.data.get('status', 'pending') != 'approved'
            && request.resource.data.get('status', 'pending') == 'pending'
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['shopId']));
      allow delete: if isAdmin()
        || (signedIn()
            && resource.data.get('claimantId', resource.data.get('uid', '')) == request.auth.uid
            && resource.data.get('status', 'pending') == 'pending');
    }

    // ---------- Collections (user-created café lists) ----------
    match /lists/{listId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);

      match /items/{itemId} {
        allow read: if signedIn();
        // Only the list owner (or an explicit participant of the list) may
        // add items — previously any signed-in user could inject into
        // another user's collection.
        allow create: if isAdmin()
          || (signedIn()
              && exists(/databases/$(database)/documents/lists/$(listId))
              && get(/databases/$(database)/documents/lists/$(listId)).data.userId == request.auth.uid)
          || (signedIn()
              && exists(/databases/$(database)/documents/lists/$(listId)/participants/$(request.auth.uid)));
        allow update, delete: if isAdmin()
          || (signedIn()
              && exists(/databases/$(database)/documents/lists/$(listId))
              && get(/databases/$(database)/documents/lists/$(listId)).data.userId == request.auth.uid);
      }

      // Shared-collection participants may see/join, list owner manages.
      match /participants/{participantId} {
        allow read: if signedIn();
        allow create: if isAdmin()
          || (signedIn()
              && exists(/databases/$(database)/documents/lists/$(listId))
              && get(/databases/$(database)/documents/lists/$(listId)).data.userId == request.auth.uid);
        allow update, delete: if isAdmin()
          || (signedIn()
              && exists(/databases/$(database)/documents/lists/$(listId))
              && get(/databases/$(database)/documents/lists/$(listId)).data.userId == request.auth.uid)
          || resource.data.get('userId', '') == request.auth.uid;
      }
    }

    // ---------- Shared collections (community hub) ----------
    match /sharedCollections/{shareId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      // sharedBy holds the uid for new docs; LEGACY docs stored a display
      // name there but always carried the real owner in `userId`, so that
      // field authorizes managing old shares without a data migration.
      allow update, delete: if isAdmin()
        || (signedIn()
            && (resource.data.sharedBy == request.auth.uid
                || resource.data.get('userId', '') == request.auth.uid));
    }

    // ---------- Job chat ----------
    match /job_chats/{chatId} {
      allow read: if isAdmin()
        || (signedIn()
            && (resource.data.get('participants', []).hasAny([request.auth.uid])
                || chatId.split('_')[0] == request.auth.uid
                || chatId.split('_')[1] == request.auth.uid));
      // Creators must be a participant of the chat they open (via the
      // participants array or the uids embedded in {uidA}_{uidB}_{jobId}
      // doc ids) — otherwise anyone could fabricate arbitrary threads.
      allow create: if signedIn()
        && request.resource.data.get('participants', []).hasAny([request.auth.uid])
        && request.resource.data.posterId in request.resource.data.participants
        && request.resource.data.applicantId in request.resource.data.participants;
      // Only chat participants (via the `participants` array, or the uids
      // embedded in legacy {uidA}_{uidB}_{jobId} doc ids) and admins may
      // update a chat thread's metadata.
      allow update: if isAdmin()
        || (signedIn()
            && (
              (resource.data.get('participants', []).hasAny([request.auth.uid])
                && request.resource.data.participants == resource.data.participants)
              || (!('participants' in resource.data)
                && request.resource.data.participants.hasAny([request.auth.uid])
                && chatId.split('_')[0] in request.resource.data.participants
                && chatId.split('_')[1] in request.resource.data.participants)
            ));
      allow delete: if isAdmin();
      match /messages/{messageId} {
        allow read: if isAdmin()
          || (signedIn()
              && (get(/databases/$(database)/documents/job_chats/$(chatId)).data.get('participants', []).hasAny([request.auth.uid])
                  || chatId.split('_')[0] == request.auth.uid
                  || chatId.split('_')[1] == request.auth.uid));
        allow create: if signedIn()
          && getAfter(/databases/$(database)/documents/job_chats/$(chatId)).data.get('participants', []).hasAny([request.auth.uid])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.recipientId in getAfter(/databases/$(database)/documents/job_chats/$(chatId)).data.participants
          && request.resource.data.recipientId != request.auth.uid;
        // Senders manage their own messages; the RECIPIENT may only mark
        // their incoming messages as read (isRead/readAt keys only). LEGACY
        // messages predate recipientId, but chat ids embed both participant
        // uids ({uidA}_{uidB}_{jobId}) — that authorizes read-marking of
        // old threads without a backfill.
        allow update: if isAdmin()
          || (signedIn()
              && resource.data.get('recipientId', '') == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']))
          || (signedIn()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt'])
              && get(/databases/$(database)/documents/job_chats/$(chatId)).data.get('participants', []).hasAny([request.auth.uid]));
        allow delete: if isAdmin()
          || (signedIn() && resource.data.senderId == request.auth.uid);
      }
    }

    match /messages/{messageId} {
      // Deprecated top-level message documents are not used by the app.
      allow read, write: if isAdmin();
    }

    // ---------- Denormalized job feeds ----------
    // Written ONLY by the Cloud Functions in functions/index.js (the Admin
    // SDK bypasses rules); clients get read-only access.
    match /allJobs/{jobId} {
      allow read: if signedIn();
      allow write: if false;
    }
    // Reserved collection, currently unused by any client or function.
    match /pendingJobs/{jobId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
